# Add these to the existing production configuration; keep the original database, payment and email settings.
# Server-only values. Never put secrets in EXPO_PUBLIC_* or VITE_*.
SHARED_PRIVATE_STORAGE_PATH=/var/data/gleenc-private
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# All accepted Google web, Android and iOS client IDs, comma separated.
GOOGLE_CLIENT_IDS=
# Apple Services ID and/or native Bundle ID audiences, comma separated.
APPLE_CLIENT_IDS=com.gleenc.app
# Keep this stable after generating package labels. Supply a strong random secret.
PACKAGE_LABEL_SECRET=
# Optional Expo push delivery. Enable enhanced push security for the project.
EXPO_PROJECT_ID=36328434-8e2f-458b-a8f3-dc3a70c03cd3
EXPO_PUSH_ACCESS_TOKEN=
# Production continues to use the original DATABASE_PROVIDER=postgres and DATABASE_URL.
# Multiple instances require shared durable private storage and a shared rate-limit store.
