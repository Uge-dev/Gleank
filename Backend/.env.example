NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173


DATABASE_PROVIDER=sqlite
DATABASE_URL=
DATABASE_PATH=./data/gleank.sqlite

# File storage
# Use local for development. Use cloudinary in production.
STORAGE_PROVIDER=local
UPLOADS_PATH=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gleenc
IMAGE_MAX_WIDTH=1800
IMAGE_WEBP_QUALITY=86
MAX_UPLOAD_MB=5

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_DAYS=7
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFICATION_MINUTES=60
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_FAILED_ATTEMPTS=5
SELLER_MONTHLY_FEE_KOBO=199900
PLATFORM_FEE_PERCENT=5
PAYMENT_PROVIDER=local
PAYSTACK_MODE=test
ALLOW_PAYSTACK_TEST_KEYS_IN_PRODUCTION=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Payment protection / Pay at Delivery safety
ENABLE_CHAT_SAFETY_FILTER=true
ENABLE_PHONE_NUMBER_MASKING=true
ENABLE_PAYMENT_KEYWORD_BLOCKING=true
ENABLE_OFF_PLATFORM_REPORTS=true
ENABLE_PAY_AT_DELIVERY=true
ENABLE_DELIVERY_OTP_LOCK=true
ENABLE_PRODUCT_CONTACT_MODERATION=true
ENABLE_STORE_CONTACT_MODERATION=true
ENABLE_ANTI_CIRCUMVENTION_SCORING=true
PAY_AT_DELIVERY_PAYMENT_WINDOW_MINUTES=10
PAY_AT_DELIVERY_REQUIRE_VERIFIED_BUYER=true
PAY_AT_DELIVERY_MIN_BUYER_SCORE=70
PAY_AT_DELIVERY_MAX_ORDER_VALUE=50000
PAY_AT_DELIVERY_DISABLE_AFTER_FAILURES=2

LIVENESS_PROVIDER=local
LIVENESS_API_KEY=
AUTO_VERIFY_AUTH=false
AUTO_ACTIVATE_SELLER_SUBSCRIPTION=true
AUTO_APPROVE_USED_LISTINGS=true
AUTO_VERIFY_RIDERS_IN_DEV=true
AUTO_SET_RIDERS_ONLINE_IN_DEV=true
ENABLE_TEST_RIDER_DISPATCH=true

# Rider dispatch timeout windows
# Campus orders: 10 minutes, local market orders: 20 minutes, heavy/fragile orders: 15 minutes.
RIDER_DISPATCH_TIMEOUT_SECONDS=600
RIDER_DISPATCH_TIMEOUT_CAMPUS_SECONDS=600
RIDER_DISPATCH_TIMEOUT_LOCAL_MARKET_SECONDS=1200
RIDER_DISPATCH_TIMEOUT_HEAVY_FRAGILE_SECONDS=900
MAX_DISPATCH_ATTEMPTS=5
SELLER_CONFIRMATION_WINDOW_MINUTES=10
RIDER_LOCATION_REFRESH_MS=30000
ALLOW_ZONE_ONLY_RIDER_DISPATCH=true
REQUIRE_GPS_FOR_HIGH_RISK_DELIVERY=true
ENABLE_AUTOMATED_DISPATCH=true
ENABLE_SELLER_RIDER_MANUAL_ASSIGNMENT=false
ENABLE_AUTOMATED_ORDER_GROUPING=true
ENABLE_AUTOMATED_DELIVERY_FEES=true
ENABLE_AUTOMATED_RELIABILITY_SCORING=true
ENABLE_AUTOMATED_INTERVENTION_QUEUE=true
ENABLE_AUTOMATED_SUBSTITUTIONS=true
ENABLE_ZONE_AVAILABILITY_CONTROL=true

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Gleenc <no-reply@gleenc.local>
SMTP_FROM_NAME=Gleenc
SMTP_FROM_EMAIL=no-reply@gleenc.local
EMAIL_PROVIDER=brevo-api
BREVO_API_KEY=
EMAIL_DIAGNOSTIC_TOKEN=

# Stage 3 provider controls
KYC_PROVIDER=manual
DOJAH_APP_ID=
DOJAH_PUBLIC_KEY=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_ENVIRONMENT=sandbox
DOJAH_WEBHOOK_SECRET=

MAP_PROVIDER=manual
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1

REALTIME_PROVIDER=sse
ENABLE_REALTIME=true
REALTIME_HEARTBEAT_MS=25000

ENABLE_OCR_MODERATION=false
OCR_PROVIDER=none
MODERATION_STRICT_MODE=false

# Prepared for future push-notification support; not required for MVP.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
