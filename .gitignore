.DS_Store

# Dependencies and generated output
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
**/coverage/
Backend/data/**/*.sqlite*
Backend/data/test/
Backend/uploads/*
!Backend/uploads/.gitkeep
!Backend/data/.gitkeep

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# Logs
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating-system files
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
**/*.sw?

# Mobile dependencies, local settings and generated files
/GleencExpo/node_modules/
/GleencExpo/.expo/
/GleencExpo/.env*
/GleencExpo/.npmrc
/GleencExpo/dist/
/GleencExpo/coverage/
/GleencExpo/**/Pods/
/GleencExpo/**/build/
/GleencExpo/**/.gradle/
/GleencExpo/**/*.apk
/GleencExpo/**/*.aab
/GleencExpo/**/*.ipa
/GleencExpo/**/*.p8
/GleencExpo/**/*.p12
/GleencExpo/**/*.jks
/GleencExpo/**/*.keystore
/GleencExpo/**/*.mobileprovision
/GleencExpo/**/credentials.json
/GleencExpo/**/service-account*.json
.DS_Store
