# Use the Vercel same-origin proxy so Safari treats auth cookies as first-party.
# Frontend/vercel.json forwards /api to the Render backend.
VITE_API_URL=/api
VITE_SUPPORT_WHATSAPP_NUMBER=2340000000000
VITE_KYC_PROVIDER=manual
VITE_DOJAH_PUBLIC_KEY=
VITE_MAP_PROVIDER=geoapify
VITE_GEOAPIFY_API_KEY=
VITE_ENABLE_REALTIME=true
