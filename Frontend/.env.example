# Local dev can stay /api because Vite proxies to the backend.
# Production should point to your deployed backend, for example:
# VITE_API_URL=https://gleank-api.onrender.com/api
VITE_API_URL=/api
VITE_SUPPORT_WHATSAPP_NUMBER=2340000000000
VITE_KYC_PROVIDER=manual
VITE_DOJAH_PUBLIC_KEY=
VITE_MAP_PROVIDER=manual
VITE_GEOAPIFY_API_KEY=
VITE_ENABLE_REALTIME=true
